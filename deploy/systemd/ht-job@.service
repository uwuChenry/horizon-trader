[Unit]
Description=horizon-trader %i job
OnFailure=ht-notify@%i.service

[Service]
Type=oneshot
WorkingDirectory=%h/horizon-trader
EnvironmentFile=%h/horizon-trader/.env
Environment=PATH=%h/horizon-trader/.venv/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/horizon-trader/.venv/bin/python -m horizon_trader.ops.jobs %i
TimeoutStartSec=3h
Nice=5
