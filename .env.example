# Copy to .env and fill in. Never commit .env.

# IBKR (IB Gateway paper port is 4002, live is 4001; TWS paper 7497 / live 7496)
IB_HOST=127.0.0.1
IB_PORT=4002
IB_CLIENT_ID=1

# Alpaca PAPER keys (dashboard -> Paper account -> API Keys). Paper keys start with PK;
# execution/alpaca_check.py refuses anything else.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# The AI competition paper account (agents/competition.py) has its own key pair.
ALPACA_COMPETITION_AI_API_KEY=
ALPACA_COMPETITION_AI_SECRET_KEY=
# One paper account per forward test (run_daily --mode alpaca; momentum and QQQ noise later)
ALPACA_DAILY_BOOK_API_KEY=
ALPACA_DAILY_BOOK_SECRET_KEY=
ALPACA_MOMENTUM_API_KEY=
ALPACA_MOMENTUM_SECRET_KEY=
ALPACA_QQQ_NOISE_API_KEY=
ALPACA_QQQ_NOISE_SECRET_KEY=

# LLM
# ANTHROPIC_API_KEY=

# Optional: where Parquet/SQLite data lives (defaults to ./data)
# HT_DATA_DIR=

# Machine role (deploy/README.md). ops = the always-on box: sends orders, writes forward-test
# state. research (default) = refuses those commands. Only ONE machine may be ops at a time.
# HT_ROLE=research

# Ops machine only: alert channels (ops/notify.py; at least one), dashboard bind address
# (Tailscale IP; never 0.0.0.0 on a public network), restic backup target.
# Discord: channel settings -> Integrations -> Webhooks -> New Webhook -> Copy URL (a secret).
# DISCORD_USER_ID = your user id (Settings -> Advanced -> Developer Mode, then right-click
# yourself -> Copy User ID); urgent alerts @mention it so your phone pings.
# DISCORD_WEBHOOK_URL=
# DISCORD_USER_ID=
# ntfy (optional second channel): pick a long random topic name.
# NTFY_TOPIC=
# HT_DASHBOARD_HOST=127.0.0.1
# RESTIC_REPOSITORY=
# RESTIC_PASSWORD_FILE=

# Massive (formerly Polygon.io), dashboard -> Keys. The downloader uses the S3 (Flat Files)
# pair; the REST API key is for future reference-data calls (splits, ticker details).
MASSIVE_API_KEY=
MASSIVE_S3_ACCESS_KEY=
MASSIVE_S3_SECRET_KEY=


# SEC EDGAR (data/sec.py) refuses requests without a contact in the User-Agent
# SEC_USER_AGENT="horizon-trader you@example.com"
